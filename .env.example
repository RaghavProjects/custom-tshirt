# Names only — no values, ever. Real values live in the deploy environment (Vercel)
# and in a local .env.local that is git-ignored. See AGENTS.md section 8.

# Supabase (Phase 1) — current key names (anon/service_role are legacy/deprecated)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Payments (Phase 6) — provider is abstracted; fill once a vendor is chosen
PAYMENT_PROVIDER=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
# Allow the sandbox (fake) gateway outside development. Never set in production.
ALLOW_SANDBOX_PAYMENTS=

# Order notification email (Phase 6)
RESEND_API_KEY=
ORDER_NOTIFY_EMAIL=

# AI design generation (Phase 10) — optional; enables the "Generate design" tool
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=

# Admin access (Phase 7) — comma-separated allowlist of admin emails
ADMIN_EMAILS=
